{
  "name": "writing-software",
  "version": "1.0.0",
  "productName": "Aura Marker Studio",
  "description": "Real-time conversation translation desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "pnpm build && electron-builder --config electron-builder.yml --publish never",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.yml --mac dmg --arm64 --publish never",
    "dist:win": "pnpm build && electron-builder --config electron-builder.yml --win nsis --x64 --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --project ui",
    "test:node": "vitest run --project node"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "onnxruntime-web": "1.24.3",
      "onnxruntime-common": "1.24.3"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "^4.0.1",
    "i18next": "^26.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "sql.js": "^1.14.1",
    "tinyld": "^1.3.4",
    "zustand": "^5.0.12"
  }
}
